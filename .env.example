# Change these values before any non-local deployment.
ADMIN_PIN=1280
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=mysql://user:password@hostname:3306/database?ssl-mode=REQUIRED
# Recommended for full TLS identity verification. Paste the Aiven CA with \n line breaks.
# MYSQL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
